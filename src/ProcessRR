public class ProcessRR {
    String name;
    int arrival;
    int burst;
    int priority;
    int remaining;
    int waiting = 0;
    int turnaround = 0;
    int completedTime = 0;

    public ProcessRR(String name, int arrival, int burst, int priority) {
        this.name = name;
        this.arrival = arrival;
        this.burst = burst;
        this.priority = priority;
        this.remaining = burst;
    }
}
